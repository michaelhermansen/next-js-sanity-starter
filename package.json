{
  "name": "next-js-sanity-starter",
  "version": "1.3.2",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run lint",
    "typegen": "sanity schema extract && sanity typegen generate",
    "typegen:watch": "pnpm typegen && concurrently \"chokidar 'src/sanity/queries/**/*' -c 'sanity typegen generate'\" \"chokidar 'src/sanity/schemas/**/*' -c 'pnpm typegen'\""
  },
  "dependencies": {
    "@next/third-parties": "^15.4.4",
    "@portabletext/react": "^3.2.1",
    "@radix-ui/react-accessible-icon": "^1.1.7",
    "@radix-ui/react-accordion": "^1.2.11",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-toggle-group": "^1.1.10",
    "@sanity/embeddings-index-ui": "^2.1.1",
    "@sanity/icons": "^3.7.4",
    "@sanity/image-url": "^1.1.0",
    "@sanity/locale-nb-no": "^1.1.25",
    "@sanity/orderable-document-list": "^1.4.0",
    "@sanity/preview-url-secret": "^2.1.14",
    "@sanity/ui": "^3.0.1",
    "@sanity/vision": "^4.1.1",
    "@t3-oss/env-nextjs": "^0.13.8",
    "@tanstack/react-query": "^5.83.0",
    "babel-plugin-react-compiler": "19.1.0-rc.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.530.0",
    "next": "15.4.4",
    "next-sanity": "^10.0.4",
    "next-themes": "^0.4.6",
    "radash": "^12.1.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-player": "^3.3.1",
    "sanity": "^4.1.1",
    "sanity-image": "^1.0.0",
    "slugify": "^1.6.6",
    "sonner": "^2.0.6",
    "styled-components": "^6.1.19",
    "tailwind-merge": "^3.3.1",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.0.10"
  },
  "devDependencies": {
    "@sanity/client": "^7.8.1",
    "@tailwindcss/postcss": "^4.1.11",
    "@types/node": "^24.1.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "chokidar-cli": "^3.0.0",
    "concurrently": "^9.2.0",
    "eslint": "^9.32.0",
    "eslint-config-next": "15.4.4",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "tailwindcss": "^4.1.11",
    "typescript": "^5.8.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@tailwindcss/oxide",
      "esbuild",
      "sharp",
      "unrs-resolver"
    ]
  }
}
